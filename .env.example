# Bot-Token aus dem Discord Developer Portal (Bot → Reset Token)
DISCORD_TOKEN=

# Channel, in den das Wochen-Leaderboard gepostet wird (Rechtsklick → ID kopieren)
LEADERBOARD_CHANNEL_ID=

# Wann gepostet wird: 0 = Montag … 6 = Sonntag
POST_WEEKDAY=6
POST_HOUR=20
POST_MINUTE=0
TIMEZONE=Europe/Berlin

# 1 = Zeit im AFK-Channel zählt nicht
IGNORE_AFK_CHANNEL=1

# Wie viele Plätze pro Rangliste angezeigt werden (0 = alle)
TOP_N=0
DB_PATH=muteboard.db

# Stumm-Quote: "all" = Mute + Full Mute zählen, "deaf" = nur Full Mute
PERCENT_BASIS=all
# Mindest-Voice-Zeit pro Woche, um in der Quoten-Rangliste aufzutauchen
PERCENT_MIN_MINUTES=120

# Sieger-Rollen (Rechtsklick auf Rolle → ID kopieren). Leer lassen = keine Rolle.
# Der Bot braucht "Rollen verwalten" und seine eigene Rolle muss ÜBER diesen Rollen stehen.
ROLE_DEAF_ID=
ROLE_MUTE_ID=
ROLE_ALL_ID=
ROLE_PERCENT_ID=
